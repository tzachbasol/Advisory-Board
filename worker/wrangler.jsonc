{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advisory-board-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tzachbasol.github.io,http://localhost:8080,http://127.0.0.1:8080"
  },
  // ANTHROPIC_API_KEY and ADMIN_PASSWORD are secrets, set by the deploy workflow.
  "durable_objects": {
    "bindings": [{ "name": "USERS", "class_name": "UserStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }]
}
